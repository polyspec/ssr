{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/ssr",
  "changelog": "docs/changelog.md",
  "changelogTranslations": [
    "docs/changelog.ko.md"
  ],
  "checks": [
    "push-gate",
    "ci-passed"
  ],
  "packages": [],
  "manifests": {
    "Cargo.toml": "version",
    "packages/core/Cargo.toml": "git-tag",
    "packages/build/Cargo.toml": "git-tag",
    "packages/runtime/Cargo.toml": "git-tag",
    "packages/adapter-react/Cargo.toml": "git-tag",
    "packages/adapter-vue/Cargo.toml": "git-tag",
    "packages/adapter-svelte/Cargo.toml": "git-tag",
    "packages/adapter-vanilla/Cargo.toml": "git-tag",
    "packages/nonce/Cargo.toml": "git-tag",
    "packages/server/Cargo.toml": "git-tag"
  },
  "notReleased": {
    "config/php-lint/composer.json": "the Composer project of the PHP lint that kit copies into every repository",
    "package.json": "the npm project that installs the package @polyspec/kit for the tools of this repository",
    "packages/build/tests/fixtures/package.json": "the npm packages of the build cases"
  },
  "goModules": {},
  "proof": {
    "gitTag": {
      "packages/core/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-core",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/build/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-build",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/runtime/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-runtime",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/adapter-react/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-adapter-react",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/adapter-vue/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-adapter-vue",
        "smoke": [
          "cargo",
          "check"
        ]
      },
      "packages/adapter-svelte/Cargo.toml": {
        "kind": "rust",
        "name": "polyspec-ssr-adapter-svelte",

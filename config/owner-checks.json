        "check-fixture-filter",
        "check-nextest"
      ]
    },
    {
      "paths": [
        "scripts/check-records.mts"
      ],
      "targets": [
        "tool-test-check-records",
        "check-records"
      ]
    },
    {
      "paths": [
        "scripts/github-ruleset.mts",
        ".github/ruleset.json"
      ],
      "targets": [
        "tool-test-github-ruleset"
      ]
    },
    {
      "paths": [
        "scripts/verify-archive.mts"
      ],
      "targets": [
        "tool-test-verify-archive",
        "tool-test-fetch-v8",
        "verify-archive"
      ]
    },
    {
      "paths": [
        "scripts/fetch-v8.mts"
      ],
      "targets": [
        "tool-test-fetch-v8"
      ]
    },
    {
      "paths": [

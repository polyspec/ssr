      ]
    },
    {
      "paths": [
        "tests/test-ownership/**",
        "config/test-ownership.json"
      ],
      "targets": [
        "tool-test-test-ownership",
        "check-ownership"
      ]
    },
    {
      "paths": [
        "config/knip-entries.json"
      ],
      "targets": [
        "kit-check",
        "lint-ts"
      ]
    },
    {
      "paths": [
        "tsconfig.json"
      ],
      "targets": [
        "typecheck",
        "lint-ts"
      ]
    },
    {
      "paths": [
        ".config/nextest.toml"
      ],
      "targets": [
        "nextest-server",
        "check-fixture-filter",
        "tool-test-install-packages"
      ]
    },
    {
      "paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/push-gate.yml"
      ],
      "targets": [
        "tool-test-workflows"
      ]
    },
    {
      "paths": [

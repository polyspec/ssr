{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by make owner-check of kit: it runs the owners of the changed paths, never the full suite. A changed tool test file runs itself through check-tools (TESTS); tool-test-<name> runs tests/tools/<name>.test.mts and nextest-<package> the tests of packages/<package>. The copies of kit are owned by kit-check.",
  "owners": [
    {
      "paths": [
        "scripts/kit/**",
        ".github/workflows/release.yml",
        ".github/workflows/gates.yml",
        ".claude/settings.json",
        "PRINCIPLES.md",
        "PRINCIPLES.ko.md",
        "config/layout.kit.yml",
        "ruff.toml",
        "phpcs.xml.dist",
        "phpstan.dist.neon",
        ".golangci.yml",
        ".oxlintrc.json",
        "knip.json",
        ".editorconfig",
        "config/api-extractor.kit.json",
        "config/pyproject.schema.json",
        "config/composer.schema.json",
        "config/cargo.schema.json",
        "config/php-lint/**"
      ],
      "targets": [
        "kit-check"
      ]
    },
    {
      "paths": [
        ".gitignore"
      ],
      "targets": [
        "check-records"
      ]
    },
    {
      "paths": [
        "CHANGELOG.md",
        "CHANGELOG.ko.md",
        "AGENTS.md",
        "AGENTS.ko.md",
        "docs/**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "docs-check",
        "check-records"
      ]
    },
    {
      "paths": [
        "config/checklist.json",
        ".githooks/pre-push"
      ],
      "targets": [
        "docs-check",
        "hooks-check",
        "push-gate-commit"
      ]
    },
    {
      "paths": [
        ".githooks/pre-commit",
        "config/generated.json"
      ],
      "targets": [
        "hooks-check",
        "staged-generated-hook"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    },
    {
      "paths": [
        "config/owner-checks.json"
      ],
      "targets": [
        "owner-validate"
      ]
    },
    {
      "paths": [
        "config/release.json"
      ],
      "targets": [
        "kit-check",
        "release-coverage"
      ]
    },
    {
      "paths": [
        "tests/tools/*.test.mts"
      ],
      "targets": [
        "check-tools"
      ],
      "variable": "TESTS"
    },
    {
      "paths": [
        "scripts/json.mts"
      ],
      "targets": [
        "tool-test-json",
        "tool-test-build-programs",
        "tool-test-install-packages",
        "tool-test-github-ruleset",
        "tool-test-verify-archive",
        "tool-test-browser-launch",
        "tool-test-workflows",
        "tool-test-workspace"
      ]
    },
    {
      "paths": [
        "scripts/schema/browser-launch.schema.json"
      ],
      "targets": [
        "tool-test-json",
        "tool-test-browser-launch"
      ]
    },
    {
      "paths": [
        "scripts/schema/cargo-message.schema.json"
      ],
      "targets": [
        "tool-test-build-programs"
      ]
    },
    {
      "paths": [
        "scripts/schema/cargo-metadata.schema.json"
      ],
      "targets": [
        "tool-test-verify-archive",
        "tool-test-install-packages",
        "check-fixture-filter",
        "tool-test-workspace"
      ]
    },
    {
      "paths": [
        "scripts/schema/json-value.schema.json"
      ],
      "targets": [
        "tool-test-json",
        "tool-test-github-ruleset"
      ]
    },
    {
      "paths": [
        "scripts/schema/nextest-config.schema.json"
      ],
      "targets": [
        "tool-test-install-packages",
        "check-fixture-filter"
      ]
    },
    {
      "paths": [
        "scripts/schema/ruleset-declaration.schema.json",
        "scripts/schema/ruleset-state.schema.json"
      ],
      "targets": [
        "tool-test-github-ruleset"
      ]
    },
    {
      "paths": [
        "scripts/schema/workflow.schema.json"
      ],
      "targets": [
        "tool-test-workflows"
      ]
    },
    {
      "paths": [
        "scripts/build-programs.mts"
      ],
      "targets": [
        "tool-test-build-programs",
        "nextest-server"
      ]
    },
    {
      "paths": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The parsed .config/nextest.toml (https://nexte.st/docs/configuration/setup-scripts/): the [[profile.default.scripts]] entries that scripts/install-packages.mts reads.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "scripts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "setup": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
                  "filter": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
